# Local development defaults only. Change all credentials before deployment.
POSTGRES_DB=surface_analyzer
POSTGRES_USER=surface
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://surface:change-me@localhost:5432/surface_analyzer
REDIS_URL=redis://localhost:6379/0
MINIO_ROOT_USER=surface
MINIO_ROOT_PASSWORD=change-me
NEXT_PUBLIC_API_URL=http://localhost:8000
# Generate a unique random value (32+ characters) before any deployment.
AUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
