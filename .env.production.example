# Surface Analyzer self-hosted installation settings
POSTGRES_DB=surface_analyzer
POSTGRES_USER=surface
POSTGRES_PASSWORD=replace-this-password
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Browser-visible API URL. Use the URL your users' browsers can reach.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Bind web to all interfaces for LAN access. Keep API loopback-bound by default.
WEB_BIND=0.0.0.0
WEB_PORT=3000
API_BIND=127.0.0.1
API_PORT=8000

# Optional local AI depth model (first inference downloads model weights into api_models volume).
# Enable with true; rebuilds the API image with PyTorch and Transformers.
INSTALL_AI=false
